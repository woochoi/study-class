{
  "name": "study-class",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --env-file=.env --test-concurrency=1 --conditions=react-server --import ./test/use-test-db.ts --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "sync:laws": "node --env-file=.env scripts/sync-laws.ts",
    "seed": "node --env-file=.env scripts/seed.ts",
    "db:apply": "node --env-file=.env scripts/db-apply.ts",
    "db:apply:test": "node --env-file=.env --import ./test/use-test-db.ts scripts/db-apply.ts",
    "db:apply:neon": "DB_TARGET=neon node --env-file=.env.neon scripts/db-apply.ts",
    "seed:neon": "DB_TARGET=neon node --env-file=.env.neon scripts/seed.ts",
    "sync:laws:neon": "DB_TARGET=neon node --env-file=.env.neon scripts/sync-laws.ts"
  },
  "dependencies": {
    "next": "16.4.4",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
